# LiveKit Cloud project (cloud.livekit.io → Settings → Keys).
# Without these three the site still runs, but rooms can't be created or joined.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public address of the site, used for canonical links, sitemap and invite links.
SITE_URL=http://localhost:3000

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX).
GA_MEASUREMENT_ID=

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Visitor log + admin panel (/admin). Neon from the Vercel Marketplace sets DATABASE_URL.
DATABASE_URL=
# 12+ characters. Without it /admin stays switched off.
ADMIN_PASSWORD=
# Optional: days to keep visitor records (default 365) and the admin's time zone.
VISITOR_RETENTION_DAYS=
ADMIN_TIMEZONE=Asia/Karachi
