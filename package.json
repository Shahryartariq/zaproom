{
  "name": "zaproom",
  "version": "1.0.0",
  "private": true,
  "description": "Video, voice and text rooms in the browser. Guest names, a live lobby, private links and random 1-to-1 chats. Next.js + LiveKit.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:call": "LIVEKIT_E2E=1 playwright test tests/e2e/call.spec.ts tests/e2e/chat.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@livekit/components-react": "^2.9.25",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.3",
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tslib": "^2.8.1",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
